# Porta HTTP da API
SERVER_PORT=8082

# Banco de dados (padrão: H2 em memória; troque para MySQL/PostgreSQL se desejar)
DB_URL=jdbc:h2:mem:raizesdb;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
JPA_DDL_AUTO=update
H2_CONSOLE_ENABLED=true

# Exemplo com PostgreSQL:
# DB_URL=jdbc:postgresql://localhost:5432/raizes_nordeste
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Segurança: chave HMAC do JWT (mínimo 32 caracteres) e validade do token em milissegundos
JWT_SECRET=troque-esta-chave-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRATION_MS=3600000

# Carga inicial de dados (unidades, produtos, estoque e usuários de demonstração)
SEED_ENABLED=true

# Nível de log das queries SQL
LOG_SQL_LEVEL=info
