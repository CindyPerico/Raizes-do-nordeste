    {
      "name": "Pedidos",
      "item": [
        {
          "name": "T06 - Criar pedido (canalPedido TOTEM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Cria o pedido do fluxo critico. Guarda o id em 'pedidoId'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"TOTEM\",\n  \"clienteId\": 1,\n  \"unidadeId\": 1,\n  \"itens\": [\n    {\n      \"produtoId\": 1,\n      \"quantidade\": 2\n    }\n  ]\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('canal registrado', () => pm.expect(body.canalPedido).to.eql('TOTEM'));",
                  "pm.test('total calculado', () => pm.expect(Number(body.total)).to.be.above(0));",
                  "pm.environment.set('pedidoId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "T07 - Filtrar pedidos por canal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos?canalPedido=TOTEM&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ],
              "query": [
                {
                  "key": "canalPedido",
                  "value": "TOTEM"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Consolidacao de pedidos por canal de atendimento.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('todos do canal TOTEM', () => body.content.forEach(p => pm.expect(p.canalPedido).to.eql('TOTEM')));"
                ]
              }
            }
          ]
        }
      ]
