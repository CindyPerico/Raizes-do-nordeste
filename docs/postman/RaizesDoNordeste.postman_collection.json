              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('email do admin', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('emailAdmin')));"
                ]
              }
            }
          ]
        }
      ]
