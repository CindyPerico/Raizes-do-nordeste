{
  "info": {
    "name": "Raizes do Nordeste API",
    "description": "Colecao de testes do fluxo principal (Pedido -> Pagamento mock -> Status) da API Raizes do Nordeste. Execute as pastas na ordem: Auth, Cardapio, Pedidos, Pagamento, Fidelidade e LGPD, Relatorios, Erros. Use o environment 'Raizes do Nordeste - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "T01 - Login valido (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login do administrador. Guarda o accessToken na variavel de ambiente 'token'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"senha\": \"{{senhaAdmin}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('retorna accessToken', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.environment.set('token', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "T02 - Login do CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login com perfil CLIENTE, usado nos testes de autorizacao (403).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCliente}}\",\n  \"senha\": \"{{senhaCliente}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('perfil CLIENTE', () => pm.expect(body.role).to.eql('CLIENTE'));",
                  "pm.environment.set('tokenCliente', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "T03 - Usuario autenticado (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
